# ============================================================
# LexClarity backend configuration
# ============================================================

ENV=development

# --- Database ---
DATABASE_URL=sqlite:///./storage/lexclarity.db

# --- Vector store ---
VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIR=./storage/chroma

# --- File storage & limits ---
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=20

# --- Embeddings ---
# Local embeddings require NO API key
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_API_KEY=

# --- LLM ---
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_BASE_URL=
LLM_MAX_TOKENS=2000
# Retries for transient provider failures (5xx, rate limits, timeouts).
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=1.5
# Rate limits (429 / token quotas) clear only when the provider's rolling
# window rolls over, so they get a longer dedicated backoff and more attempts.
LLM_RATE_LIMIT_BACKOFF_SECONDS=12.0
LLM_RATE_LIMIT_BACKOFF_MAX_SECONDS=45.0
LLM_RATE_LIMIT_RETRIES=5
# Client-side pacing against the provider's tokens-per-minute budget (0 = off).
# Groq's free tier meters ~8000 tokens/min — pace just under it so a
# multi-stage pipeline never bursts into a 429. Set to your plan's TPM.
# NOTE: Groq's free tier ALSO enforces a tokens-per-DAY (TPD) quota (~200k/day
# on openai/gpt-oss-120b). When that is hit, the API returns 429 with
# `retry-after` of many minutes. LexClarity detects this "daily" dimension and
# fails fast (no blind retries), keeps whatever sections already succeeded, and
# names the skipped ones so you can Re-analyze once the daily window resets.
LLM_TOKEN_BUDGET_PER_MINUTE=0

# Optional cloud providers:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=your-anthropic-api-key
# LLM_MODEL=claude-sonnet-4-6
#
# LLM_PROVIDER=openai
# LLM_API_KEY=your-openai-api-key
# LLM_MODEL=gpt-4o-mini
#
# LLM_PROVIDER=gemini
# LLM_API_KEY=your-gemini-api-key
# LLM_MODEL=gemini-3.6-flash
#
# LLM_PROVIDER=groq
# LLM_API_KEY=your-groq-api-key
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_TOKEN_BUDGET_PER_MINUTE=6500   (free tier meters ~8000 tokens/min)

# --- Chunking ---
CHUNK_SIZE_TOKENS=350
CHUNK_OVERLAP_TOKENS=60

# --- RAG retrieval ---
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SIMILARITY=0.25

# --- Auth ---
DEMO_USER_ID=demo-user
SECRET_KEY=change-me-in-production

# --- Trust & verification engine ---
# auto = use local NLI model if loadable, else LLM judge (labelled as non-proof)
# nli = force the local NLI model; llm = force LLM judge; off = deterministic only
VERIFIER_PROVIDER=auto
VERIFIER_NLI_MODEL=cross-encoder/nli-MiniLM2-L6-H768

# --- OCR fallback (scanned/image PDFs) ---
# Requires: pip install pymupdf pytesseract + the Tesseract binary on the system.
OCR_ENABLED=true
OCR_LANG=eng

# --- CORS ---
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001